{
  "name": "kova",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:android": "vite build --mode android && npx cap sync android",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "paypal:check": "tsx --env-file=.env scripts/paypal-sandbox.ts check",
    "paypal:seed": "tsx --env-file=.env scripts/paypal-sandbox.ts seed",
    "paypal:capture": "tsx --env-file=.env scripts/paypal-sandbox.ts capture",
    "account:delete": "tsx scripts/delete-account.ts",
    "test": "tsx --test server/account.test.ts server/httpSafety.test.ts server/plans.test.ts server/tone.test.ts server/channel3.test.ts server/priceWatch.test.ts server/aiBudget.test.ts src/utils/growthMarks.test.ts server/billing.test.ts server/paypal/checkin.test.ts server/paypal/checkinStore.test.ts server/paypal/paypalService.test.ts server/paypal/agent.test.ts src/utils/paypalIntent.test.ts src/utils/chatIntents.test.ts src/utils/affordability.test.ts src/utils/subscriptionRadar.test.ts src/lib/statementImport/statementImport.test.ts"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.1",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@google/genai": "^2.4.0",
    "@revenuecat/purchases-capacitor": "^13.5.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.4.0",
    "framer-motion": "^14.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}

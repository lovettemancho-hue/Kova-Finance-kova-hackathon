# Kova environment variables. Copy this file to `.env` for local development:
#   Copy-Item .env.example .env        (PowerShell)
# `.env` is gitignored and excluded from the Docker image (.dockerignore), so it is LOCAL ONLY.
# Production never reads it: Cloud Run gets plain settings from deploy.yml (GitHub repo variables)
# and secrets from Google Secret Manager. "Prod:" on each line says where that value lives.
# Never put a secret in a VITE_ variable: those are baked into the app bundle anyone can read.

# ---------- Server ----------
PORT=3000                               # Prod: set by Cloud Run (8080)

# ---------- Firebase (Admin SDK, server) ----------
# Locally: sign in once with `gcloud auth application-default login` (no service-account key file).
# There is no separate dev project yet: the local server uses the PRODUCTION database.
FIREBASE_PROJECT_ID=kova-98d67          # Prod: repo variable GCP_PROJECT_ID
FIRESTORE_DATABASE_ID=ai-studio-kova-f30aae12-0bf9-4314-9e74-d6bc2a94c9ed   # Prod: firebase-applet-config.json
# FIREBASE_SERVICE_ACCOUNT_KEY=         # Not used: the Cloud Run service account / your gcloud login is used

# ---------- Gemini (server only) ----------
GEMINI_BACKEND=vertex                   # Prod: deploy.yml. vertex = Vertex AI, billed to Blaze, no API key
GOOGLE_CLOUD_PROJECT=kova-98d67
GOOGLE_CLOUD_LOCATION=global
# GEMINI_API_KEY=                       # Only if GEMINI_BACKEND is unset. Prod: Secret Manager gemini-api-key

# ---------- Plans ----------
PLAN_ADMIN_UIDS=                        # Your Firebase UID(s), comma-separated. Prod: repo variable PLAN_ADMIN_UIDS

# ---------- Cron (Cloud Scheduler -> /api/cron/*) ----------
CRON_SECRET=                            # Any long random value locally. Prod: Secret Manager cron-secret

# ---------- PayPal Money Check-in (sandbox only) ----------
PAYPAL_MODE=mock                        # mock = demo data, real = PayPal sandbox. Prod: repo variable PAYPAL_MODE
PAYPAL_CLIENT_ID=                       # Sandbox app "KOVA" client ID (not secret). Prod: repo variable PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=                   # SECRET. Prod: Secret Manager paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SUBSCRIPTION_IDS=                # From `npm run paypal:seed`. Prod: repo variable PAYPAL_SUBSCRIPTION_IDS
PAYPAL_ACCESS_UIDS=                     # Invite-only: Firebase UIDs that can see PayPal at all (default: PLAN_ADMIN_UIDS). Everyone else never sees it. Prod: repo variable PAYPAL_ACCESS_UIDS

# ---------- Premium billing (KOVA-077, docs/BILLING.md) ----------
REVENUECAT_SECRET_KEY=                  # SECRET (sk_...). Prod: Secret Manager revenuecat-secret-key
REVENUECAT_WEBHOOK_AUTH=                # SECRET. Prod: Secret Manager revenuecat-webhook-auth
VITE_REVENUECAT_GOOGLE_API_KEY=         # Public SDK key (goog_...), only for `npm run build:android`

# ---------- Product prices (KOVA-101, "Can I afford <product>?") ----------
CHANNEL3_API_KEY=                       # SECRET. Free key at trychannel3.com. Prod: Secret Manager channel3-api-key + repo variable CHANNEL3_ENABLED=true
